{
  "uid": "macos-agent-overview",
  "title": "macOS Agent — Overview",
  "tags": ["macos-agent", "phase4"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "macos-agent-prom" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Spend & Cost",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Spend this month (USD)",
      "description": "increase() over 30d handles counter resets on process restart. Exact per-user monthly cost lives in the usage_log table and drives the $0.25 cap.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4,
        "color": { "mode": "thresholds" },
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "red", "value": 20 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(increase(macos_chat_cost_usd_total[30d]))" } ]
    },
    {
      "type": "stat",
      "title": "Spend last 24h (USD)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [ { "refId": "A", "expr": "sum(increase(macos_chat_cost_usd_total[24h]))" } ]
    },
    {
      "type": "timeseries",
      "title": "Cost rate (USD/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 15 } } },
      "targets": [ { "refId": "A", "expr": "sum(rate(macos_chat_cost_usd_total[5m])) * 60", "legendFormat": "USD/min" } ]
    },
    {
      "type": "row",
      "title": "Traffic & Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Request rate by outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (rate(macos_chat_requests_total[5m]))", "legendFormat": "{{outcome}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Error rate by type",
      "description": "Provider-error classes from classify_llm_error (rate_limit, quota_exhausted, timeout, auth, other).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } } },
      "targets": [ { "refId": "A", "expr": "sum by (error_type) (rate(macos_chat_errors_total[5m]))", "legendFormat": "{{error_type}}" } ]
    },
    {
      "type": "stat",
      "title": "Error ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1,
        "color": { "mode": "thresholds" },
        "thresholds": { "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 0.1 },
          { "color": "red", "value": 0.25 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [ { "refId": "A", "expr": "sum(rate(macos_chat_requests_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(macos_chat_requests_total[5m])), 0.0001)" } ]
    },
    {
      "type": "timeseries",
      "title": "Turn latency (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(macos_chat_turn_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(macos_chat_turn_duration_seconds_bucket[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "row",
      "title": "Feedback & Guardrails",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }
    },
    {
      "type": "timeseries",
      "title": "Feedback (up vs down)",
      "description": "Bad-feedback spikes = a rise in the down series.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "down" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "up" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ] },
      "targets": [ { "refId": "A", "expr": "sum by (rating) (increase(macos_feedback_total[1h]))", "legendFormat": "{{rating}}" } ]
    },
    {
      "type": "gauge",
      "title": "Positive feedback ratio",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 0.5 },
          { "color": "green", "value": 0.75 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(macos_feedback_total{rating=\"up\"}) / clamp_min(sum(macos_feedback_total), 1)" } ]
    },
    {
      "type": "timeseries",
      "title": "Guardrail activity",
      "description": "PII spans redacted, abusive requests blocked, credit refusals.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 21 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 15 } } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(macos_pii_redactions_total[1h]))", "legendFormat": "pii redactions" },
        { "refId": "B", "expr": "sum(increase(macos_abuse_blocks_total[1h]))", "legendFormat": "abuse blocks" },
        { "refId": "C", "expr": "sum(increase(macos_credit_refusals_total[1h]))", "legendFormat": "credit refusals" }
      ]
    },
    {
      "type": "row",
      "title": "Tokens",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 }
    },
    {
      "type": "timeseries",
      "title": "Token throughput by direction",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } } },
      "targets": [ { "refId": "A", "expr": "sum by (direction) (rate(macos_chat_tokens_total[5m]))", "legendFormat": "{{direction}} tok/s" } ]
    },
    {
      "type": "timeseries",
      "title": "LLM calls / min",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [ { "refId": "A", "expr": "sum(rate(macos_chat_llm_calls_total[5m])) * 60", "legendFormat": "calls/min" } ]
    }
  ]
}

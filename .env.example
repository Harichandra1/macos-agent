# Copy this file to .env and fill in your credentials.
# Never commit .env to git.

# OpenAI — used for text-embedding-3-small
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Qdrant Cloud — persistent vector database
# 1. Create free account: https://cloud.qdrant.io
# 2. Create a cluster (free tier is enough for this project)
# 3. Copy the Cluster URL and API Key from the dashboard
QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=...

# Collection name (no need to create it manually — ingest.py creates it)
QDRANT_COLLECTION=macos_kb

# --- LLM providers (all OpenAI-compatible; pick per role below) ---
# The agent's LLM roles (intake / smart-merge / synth) and the benchmark judges
# are provider-pluggable. Set the API key for whichever providers you use.
# Groq — fast Llama/Qwen inference, free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# NVIDIA NIM — free hosted models: https://build.nvidia.com  (key starts nvapi-)
NVIDIA_API_KEY=nvapi-...
# OpenRouter — many free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Per-role provider + model selection (defaults shown → all Groq, no change needed).
# Providers: groq | nvidia | openrouter | openai
# SYNTH_PROVIDER=groq
# SYNTH_MODEL=llama-3.3-70b-versatile
# INTAKE_PROVIDER=groq
# INTAKE_MODEL=llama-3.1-8b-instant
# FILTER_PROVIDER=groq
# FILTER_MODEL=llama-3.1-8b-instant

# Web search behaviour: smart (version-gap/low-coverage) | always | off
# WEB_SEARCH_MODE=smart

# Per-call LLM retry count (exponential backoff with jitter via the OpenAI SDK;
# a 429's Retry-After header is honored). Default 2.
# LLM_MAX_RETRIES=2

# Redact PII (emails, MAC addresses, IPs, /Users/<name> paths, serial numbers)
# from user messages before they reach any LLM provider. Default true —
# disable only for local debugging.
# PII_REDACTION=true

# Tavily — web search fallback scoped to apple.com
# Get yours at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# --- Benchmark judges (Agent/eval/benchmark.py only — NOT needed to serve) ---
# Independent LLM judges for the head-to-head "beat the frontier" benchmark.
# Neither is a contestant (contestants are GPT-4o + Llama-70B), so they grade
# without self-preference bias.
# Anthropic (Claude judge):  https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# xAI (Grok judge):          https://console.x.ai
XAI_API_KEY=xai-...

# --- Serving config (Agent/backend — all optional, sensible defaults) ---
# Persistent conversation memory across restarts (SQLite path). Unset = in-memory.
# AGENT_CHECKPOINT_DB=/data/agent_checkpoints.sqlite
# Comma-separated allowed origins for the browser frontend; "*" for dev.
# CORS_ORIGINS=*

# --- Oracle production activation (keep actual values in .env.production) ---
# APP_ENV=production
# APP_DOMAIN=macos-agent-hari.duckdns.org
# APP_ORIGIN=https://macos-agent-hari.duckdns.org
# CORS_ORIGINS=https://macos-agent-hari.duckdns.org
# TRUSTED_HOSTS=macos-agent-hari.duckdns.org,app,127.0.0.1
# METRICS_TOKEN=generate-with-openssl-rand-hex-32

# --- Database (Phase 1: users; later: credits, cost ledger, feedback) ---
# Defaults to a local SQLite file (Agent/backend/data/app.db). In deployment,
# point at Postgres — the Alembic migrations are dialect-neutral.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/macosagent

# --- Authentication (Google Sign-In) ---
# Auth is OFF until GOOGLE_CLIENT_ID is set (dev runs open; the frontend hides
# the sign-in UI). Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add your app origin
# (e.g. http://localhost:8000) to "Authorized JavaScript origins".
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# HS256 secret for our session JWTs (any long random string). Unset = ephemeral
# per-process secret: sessions reset on restart.
# AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime in hours (default 168 = 7 days).
# AUTH_TOKEN_TTL_HOURS=168

# --- Grafana Cloud + Oracle edge (production only) ---
# GRAFANA_PROMETHEUS_REMOTE_WRITE_URL=https://...
# GRAFANA_PROMETHEUS_USERNAME=...
# GRAFANA_LOKI_WRITE_URL=https://...
# GRAFANA_LOKI_USERNAME=...
# GRAFANA_CLOUD_API_KEY=...
# DUCKDNS_DOMAIN=macos-agent-hari
# DUCKDNS_TOKEN=...
# ACME_EMAIL=you@example.com

# --- Credits (Phase 3; enforced only for authenticated users) ---
# Chat turns per user per ISO week (lazy refresh on the week boundary).
# WEEKLY_CREDIT_LIMIT=5
# Cumulative provider cost per user per calendar month, in USD. Free-tier
# calls are billed at the provider's LIST price so the cap measures real
# consumption.
# MONTHLY_COST_CAP_USD=0.25

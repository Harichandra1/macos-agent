# Copy to /opt/macos-agent/.env.production and fill values. Never commit it.

# Serving image published by .github/workflows/build-image.yml. Override only
# if you fork the repo under a different owner (GHCR paths are lowercase).
# Do NOT set APP_IMAGE_TAG here — deploy.sh and rollback.sh export it as the
# commit SHA they are deploying, and the shell value wins over this file.
APP_IMAGE=ghcr.io/harichandra1/macos-agent

APP_ENV=production
APP_DOMAIN=macos-agent-hari.duckdns.org
APP_ORIGIN=https://macos-agent-hari.duckdns.org
CORS_ORIGINS=https://macos-agent-hari.duckdns.org
# Public Caddy host plus Docker-internal app/healthcheck hosts.
TRUSTED_HOSTS=macos-agent-hari.duckdns.org,app,127.0.0.1
ACME_EMAIL=you@example.com
DUCKDNS_DOMAIN=macos-agent-hari
DUCKDNS_TOKEN=replace-me

GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
METRICS_TOKEN=replace-with-at-least-32-random-characters

OPENAI_API_KEY=replace-me
GROQ_API_KEY=replace-me
QDRANT_URL=https://replace-me:6333
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=macos_kb
TAVILY_API_KEY=replace-me

GRAFANA_PROMETHEUS_REMOTE_WRITE_URL=https://replace-me/api/prom/push
GRAFANA_PROMETHEUS_USERNAME=replace-me
GRAFANA_LOKI_WRITE_URL=https://replace-me/loki/api/v1/push
GRAFANA_LOKI_USERNAME=replace-me
GRAFANA_CLOUD_API_KEY=replace-me
